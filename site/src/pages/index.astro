---
import '../styles/landing.css';
import roadmap from '../../../ROADMAP.md?raw';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (p: string) => `${base}${p}/`;
const repo = 'https://github.com/DarKnight1346/rein-harness';
const title = 'Rein — the agent harness for your whole system';
const description =
  'Rein drives the official Claude Code and Codex CLIs across every account you have and every repo in your system: failover, auto routing, verified goals, workspaces, costs and one shared tool set.';

// The open-source roadmap (ROADMAP.md), for the progress shown on this page.
const status = new Map([...roadmap.matchAll(/^\| (\d+) \| .* \| (todo|done|blocked[^|]*) \|$/gm)].map((m) => [Number(m[1]), m[2]]));
const big = [
  {title: 'Multi-repo workspaces', body: 'Every repo in one session, with roles the agent understands and one AGENTS.md for all.', href: 'features/workspaces', ids: [1, 2, 3, 29, 9, 30, 31, 32, 33, 34, 35, 36, 37]},
  {title: 'Cost and budgets', body: 'Dollars per request, conversation and goal, and caps that stop runaway work.', href: 'features/cost', ids: [4, 7, 72, 5, 6, 8, 24, 73]},
  {title: 'Safety guards', body: 'Secret scanning, SAST, prompt-injection and exfiltration guards, policy as code.', ids: [10, 18, 19, 67, 68, 69, 70, 71]},
  {title: 'CI and PR automation', body: 'Affected tests only, a CI watcher that fixes failures, self-review, stacked PRs.', ids: [11, 12, 13, 23, 46, 47, 48, 49, 50, 51, 52, 14, 15, 16, 17, 25, 39, 63, 64, 65, 66]},
  {title: 'Specs', body: 'Requirements, design and tasks approved in turn, with traceability to the code.', ids: [20, 21, 22, 53, 54, 55, 56, 57, 58]},
  {title: 'Contracts and migrations', body: 'Breaking-change detection, safe schema changes, codemods and playbooks.', ids: [38, 40, 41, 42, 43, 44, 45]},
  {title: 'System-level understanding', body: 'Service and symbol graphs across repos, impact reports, coordinated changes.', ids: [105, 106, 107, 108, 109, 110, 111, 112]},
].map((b) => {
  const shipped = b.ids.filter((id) => status.get(id) === 'done').length;
  return {...b, href: b.href ?? 'start/whats-new', shipped, total: b.ids.length};
});
const shippedAll = [...status.values()].filter((s) => s === 'done').length;

// Six things Rein does, each with the real UI line it shows you.
const rows = [
  {k: 'Failover', h: 'Never stranded on a rate limit.', p: 'Work spreads across every Claude and ChatGPT account you sign in. Rein moves before a limit rejects you and carries the conversation across providers mid-task.', code: '<span class="t-yellow">Load balancing:</span> Claude Account 1 is near its limit — switching to Claude Account 2 before it\'s rejected', href: 'features/accounts'},
  {k: 'Routing', h: 'The right model for each message.', p: 'A cheap decision model picks the cheapest model that will answer well, and never sees your transcript.', code: '<span class="t-dim">› design the cache layer</span>\n<span class="t-dim">→</span> <span class="t-cyan">Opus · effort high</span> <span class="t-dim">(auto · 0.91)</span>', href: 'features/routing'},
  {k: 'Goals', h: 'Done means proven.', p: 'The agent keeps going until a reviewer accepts the evidence: passing tests, verified output. "Impossible" escalates instead of ending.', code: '<span class="t-green">⏺</span> <b>Shell</b><span class="t-dim">(npm test)</span>  <span class="t-green">✓ 48 passed</span>\n<span class="t-green">◎ Goal achieved and verified</span>', href: 'features/goals'},
  {k: 'Workspaces', h: 'Your whole system in one session.', p: 'A rein.workspace.yaml makes every repo a working directory, tells the agent what each one does, and applies one AGENTS.md to all.', code: '<span class="t-dim">›</span> /workspace\n  <span class="t-green">✓</span> api   <span class="t-dim">orders API (provider)</span>\n  <span class="t-green">✓</span> web   <span class="t-dim">storefront, calls the orders API</span>', href: 'features/workspaces'},
  {k: 'Cost', h: 'Every request priced. Every budget kept.', p: 'Dollars per request, conversation and goal at API list prices, with caps that stop the agent before it overruns them.', code: '<span class="t-dim">›</span> /cost\n  this conversation  <b>$4.12</b>\n  goal so far        <b>$3.10</b>\n  goal budget        <b>$3.10</b> <span class="t-dim">of $20.00</span>', href: 'features/cost'},
  {k: 'Rewind', h: 'Undo anything. Even shell commands.', p: 'Whole-project snapshots before every message, in a private git store that never touches your repo.', code: '<span class="t-cyan">❯ Restore code and conversation</span>\n<span class="t-dim">  Restore conversation only</span>\n<span class="t-dim">  Restore code only</span>', href: 'features/rewind'},
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#07080a" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={base}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        rein
      </a>
      <nav>
        <a href={docs('start/introduction')}>Docs</a>
        <a href={docs('start/whats-new')}>What's new</a>
        <a href={docs('internals/architecture')}>How it works</a>
        <a class="gh" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <!-- HERO: the 3D scene fills it; the copy sits on top -->
      <section class="hero">
        <canvas id="hero3d" aria-hidden="true"></canvas>
        <div class="orb-labels" id="orb-labels" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow reveal">Open source · MIT · runs the official <code>claude</code> &amp; <code>codex</code> CLIs</p>
          <h1 class="reveal">The agent harness<br />for your <em>whole&nbsp;system</em>.</h1>
          <p class="lede reveal">
            Every account you have. Every model. Every repo. Rein drives Claude Code and Codex as one pool, routes each task to the right model, and keeps
            working until the evidence says it's done.
          </p>
          <div class="cta reveal">
            <button class="install" data-copy="npm install -g rein-harness" aria-label="Copy install command">
              <span class="prompt">$</span> npm install -g rein-harness
              <span class="copied">Copied</span>
            </button>
            <a class="btn" href={docs('start/introduction')}>Read the docs <span aria-hidden="true">→</span></a>
          </div>
          <p class="hint reveal">Drag to turn · Node 22+ · macOS, Linux &amp; Windows</p>
        </div>
      </section>

      <!-- DEMO -->
      <section class="demo" id="see-it">
        <div class="head reveal">
          <p class="kicker">A real session, sped up</p>
          <h2>Watch it fail over, fork a question, and prove the fix.</h2>
        </div>
        <div class="term-wrap">
          <div class="glow" aria-hidden="true"></div>
          <div class="term" id="demo" aria-label="Animated demo of the Rein terminal UI">
            <div class="chrome">
              <i></i><i></i><i></i>
              <span class="ttl">~/code/api — rein</span>
            </div>
            <div class="topbar">
              <span class="t-rainbow">▁▃▅▇ Rein</span>
              <span class="sep">│</span><span id="tb-model" class="t-cyan">Opus (auto)</span>
              <span class="sep">│</span><span id="tb-acct">Claude Account 1</span>
              <span class="sep">│</span><span id="tb-usage" class="t-dim">5h 84% · weekly 31%</span>
              <span class="sep">│</span><span class="t-green" id="tb-ctx">ctx 12%</span>
              <span class="sep hide-sm">│</span><span class="t-cyan hide-sm" id="tb-goal">◎ goal · active · 0/3</span>
              <span class="grow"></span><span class="t-dim">[≡]</span>
            </div>
            <div class="body">
              <div class="history" id="history"></div>
              <aside class="sidebar">
                <div class="sec">
                  <div class="h">GOAL · <span id="sb-goal-n">0/3</span></div>
                  <div class="t-dim small">Fix the auth tests</div>
                  <div class="meter"><span id="sb-goal-bar" style="width:0%"></span></div>
                  <div class="ms" id="ms1"><b>▸</b> Reproduce failure</div>
                  <div class="ms" id="ms2"><b>○</b> Fix session expiry</div>
                  <div class="ms" id="ms3"><b>○</b> Full suite green</div>
                </div>
                <div class="sec">
                  <div class="h">ACCOUNTS</div>
                  <div class="acct"><span>Claude Account 1</span><span class="pct" id="a1p">84%</span></div>
                  <div class="meter"><span id="a1" class="warn" style="width:84%"></span></div>
                  <div class="acct"><span>Claude Account 2</span><span class="pct" id="a2p">9%</span></div>
                  <div class="meter"><span id="a2" style="width:9%"></span></div>
                  <div class="acct"><span>Codex Account 1</span><span class="pct">22%</span></div>
                  <div class="meter"><span style="width:22%"></span></div>
                </div>
                <div class="sec">
                  <div class="h">AGENTS</div>
                  <div class="small"><span class="t-green">●</span> main</div>
                  <div class="small" id="sb-agent" style="opacity:.35"><span class="t-magenta">●</span> test-runner · Haiku</div>
                </div>
              </aside>
              <div class="btw-win" id="btw">
                <div class="btw-h"><span>btw · why did the tests fail?</span><span class="t-dim">[×]</span></div>
                <div class="btw-b" id="btw-body"></div>
                <div class="btw-f t-dim">Opus · forked agent · not added to the conversation</div>
              </div>
            </div>
            <div class="activity" id="activity"><span class="t-dim">esc interrupt · ctrl+c stop (twice to exit) · /btw to ask</span></div>
            <div class="input"><span class="t-cyan">›</span> <span id="typed"></span><span class="caret"></span></div>
          </div>
        </div>

      </section>

      <!-- WHAT IT DOES -->
      <section class="rows" id="features">
        {
          rows.map((r, i) => (
            <a class="row reveal" href={docs(r.href)}>
              <div class="row-txt">
                <span class="num">{String(i + 1).padStart(2, '0')} · {r.k}</span>
                <h3>{r.h}</h3>
                <p>{r.p}</p>
              </div>
              <div class="mini tilt">
                <div class="mini-bar" aria-hidden="true"><i /><i /><i /><span>rein</span></div>
                <pre class="row-code" set:html={r.code} />
              </div>
            </a>
          ))
        }
      </section>

      <!-- BIG SYSTEMS -->
      <section class="systems" id="big-systems">
        <div class="head reveal">
          <p class="kicker">Built for big systems · {shippedAll} of {status.size} shipped</p>
          <h2>From one repo to the whole platform.</h2>
          <p>Open-source features for very large, multi-repo codebases, shipping in waves. <a href={docs('start/whats-new')}>See what's new →</a></p>
        </div>
        <div class="caps">
          {
            big.map((b) => (
              <a class="cap reveal tilt" href={docs(b.href)} style={`--p:${b.shipped / b.total}`}>
                <div class="cap-top">
                  <b>{b.title}</b>
                  <span class="count">{b.shipped === b.total ? 'Shipped' : b.shipped ? `${b.shipped}/${b.total}` : 'Next'}</span>
                </div>
                <p>{b.body}</p>
                <div class="bar"><span /></div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- HOW -->
      <section class="how" id="how">
        <div class="head reveal">
          <p class="kicker">How it works</p>
          <h2>No tokens extracted. Ever.</h2>
          <p>All model traffic goes through the official binaries, signed in the normal way. Rein orchestrates: one transcript, one tool set, every model.</p>
        </div>
        <div class="flow reveal">
          <div class="node">You<span>terminal UI · <code>rein -p</code></span></div>
          <div class="wire" aria-hidden="true"><i></i></div>
          <div class="node core">Rein<span>transcript · router · accounts · tools · approvals</span></div>
          <div class="wire" aria-hidden="true"><i></i></div>
          <div class="stack">
            <div class="node">claude<span>stream-json</span></div>
            <div class="node">codex<span>app-server</span></div>
          </div>
        </div>
        <div class="stats reveal">
          <div><b>0</b><span>OAuth tokens touched</span></div>
          <div><b>2</b><span>official CLIs, one tool set</span></div>
          <div><b>3</b><span>OSes tested on every PR</span></div>
          <div><b>MIT</b><span>licensed, open source</span></div>
        </div>
      </section>

      <!-- FINAL -->
      <section class="final reveal">
        <h2>Start in one command.</h2>
        <button class="install big" data-copy="npm install -g rein-harness">
          <span class="prompt">$</span> npm install -g rein-harness
          <span class="copied">Copied</span>
        </button>
        <p>then <code>cd</code> into a project and run <code>rein</code> · <a href={docs('project/contributing')}>contribute on GitHub</a></p>
      </section>
    </main>

    <footer class="foot">
      <span>Rein · MIT licensed</span>
      <div>
        <a href={docs('start/introduction')}>Docs</a>
        <a href={docs('project/security')}>Security</a>
        <a href={repo}>GitHub</a>
        <a href="https://www.npmjs.com/package/rein-harness">npm</a>
      </div>
    </footer>

    <script>
      import '../scripts/landing.ts';
      import {startHero} from '../scripts/hero3d.ts';
      const canvas = document.getElementById('hero3d') as HTMLCanvasElement | null;
      const labels = document.getElementById('orb-labels');
      if (canvas && labels) startHero(canvas, labels);
    </script>
  </body>
</html>
