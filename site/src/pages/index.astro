---
import '../styles/landing.css';
import '../styles/landing-v2.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (p: string) => `${base}${p}/`;
const repo = 'https://github.com/DarKnight1346/rein-harness';
const title = 'Rein — every AI subscription, one terminal';
const description =
  'Rein drives the official Claude Code and Codex CLIs across all your accounts, and gives every model the same superpowers: verified goals, plans, undo for anything, code intelligence in 45 languages, a secrets vault, voice, and remote control from your phone.';

const pillars = [
  {
    n: '01',
    title: 'Pool every subscription',
    body: 'Every Claude and ChatGPT account you sign in becomes one pool. Rein balances the work, moves before a limit rejects you, carries the conversation across providers mid-task, and when everything is spent it waits for the reset and keeps going.',
    points: ['Load balancing before limits', 'Failover that keeps your context', 'Waits for resets, then continues'],
    href: 'features/accounts',
  },
  {
    n: '02',
    title: 'The same superpowers on every model',
    body: "One tool set, implemented once, reaches Claude and GPT alike. Goals that need evidence to finish, plans before edits, undo that covers shell commands, subagents in their own worktrees, and a code check before the agent says it's done.",
    points: ['Verified goals & milestone plans', '/rewind for any change', 'Code intelligence in 45 languages'],
    href: 'features/tools',
  },
  {
    n: '03',
    title: 'Run it from anywhere',
    body: 'Pair your phone with the page your own Rein serves. Watch the work, answer approvals, send the next message. Label an issue and Rein takes it on its own branch, then reports back on the issue.',
    points: ['Remote page, no hosted service', 'GitHub, Linear, GitLab, Jira, Azure DevOps', 'Pings your phone when it needs you'],
    href: 'features/remote',
  },
];

const features = [
  {tag: 'failover', title: 'Never stranded on a rate limit', body: 'Spread work across every account, switch before a limit hits, and carry the conversation across Claude and Codex mid-task.', href: 'features/accounts', span: 'wide', viz: 'bars'},
  {tag: 'auto', title: 'The right model per task', body: 'Auto mode routes each message to a model and effort that fits it, and keeps your prompt cache warm while it does.', href: 'features/routing', viz: 'route'},
  {tag: 'code check', title: "Doesn't stop with your build broken", body: 'Language servers for 45 languages check what the turn changed, and the files that import it. New errors go back to the agent before it finishes.', href: 'features/code-intelligence', viz: 'lsp', span: 'tall'},
  {tag: '/goal', title: 'Done means proven', body: 'The agent keeps going until a reviewer accepts evidence: passing tests, verified output.', href: 'features/goals', viz: 'goal'},
  {tag: 'vault', title: 'Secrets it uses but never sees', body: 'Store a token once. Every command gets it as $NAME; anything that would show it to the model shows [secret:NAME].', href: 'features/vault', viz: 'vault'},
  {tag: '/plan', title: 'Plan before you touch a file', body: 'Read-only exploration, questions, then a milestone plan that runs as a verified goal.', href: 'features/plans', viz: 'plan'},
  {tag: '/rewind', title: 'Undo anything. Even shell commands.', body: 'Whole-project snapshots before every message, in a private store that never touches your repo.', href: 'features/rewind', viz: 'rewind'},
  {tag: 'remote', title: 'Your session, on your phone', body: 'A page your Rein serves, paired with a one-time code. Approvals show on both; first answer wins.', href: 'features/remote', viz: 'remote', span: 'wide'},
  {tag: 'issues', title: 'Label an issue. Get a branch.', body: 'Assign it with the rein label; Rein works on a new branch and comments its report. Every action asks: issue text is untrusted.', href: 'features/trackers', viz: 'tracker'},
  {tag: 'voice', title: 'Hold Ctrl+Space and talk', body: 'Speech to text on your machine with whisper.cpp. Nothing is uploaded; the text lands in the input.', href: 'features/voice', viz: 'voice'},
  {tag: 'sampling', title: 'MCP servers use your subscriptions', body: 'Servers that need a model ask Rein, and get one of your signed-in models instead of needing their own API key.', href: 'features/mcp', viz: 'sampling'},
  {tag: '/btw', title: 'Ask without interrupting', body: 'A side question forks the live session while the main agent keeps working.', href: 'features/btw', viz: 'btw'},
  {tag: 'agents', title: 'Subagents on any model', body: 'Fork the conversation or start fresh on any signed-in model. Parallel ones get private worktrees that merge back on their own.', href: 'features/subagents', viz: 'agents', span: 'full'},
];

const compat = ['Claude Code', 'Codex CLI', 'VS Code', 'Cursor', 'JetBrains', 'Neovim', 'MCP', 'GitHub', 'Linear', 'GitLab', 'Jira', 'Azure DevOps', 'ntfy', 'Tailscale'];

const compare = [
  ['Accounts', 'One account per CLI install', 'Every Claude and ChatGPT account in one balanced pool'],
  ['Models', "One provider's models", 'Claude and GPT in the same conversation, context carried over'],
  ['Hitting a limit', 'Wait, or start over in another tool', 'Moves before it hits; waits for the reset and continues'],
  ['Tools & workflows', "Each CLI's own", 'One tool set, goals, plans and rewind, identical on every model'],
  ['Before "done"', 'Up to the model', 'Language servers check what changed; new errors go back to the agent'],
  ['Secrets', 'In files and env vars the model can read', 'In a vault: used by commands, masked from the model'],
  ['Away from the keyboard', '—', 'Phone page, issue triggers, notifications'],
];

const proof = [
  {big: '10 / 10', small: 'refactors compiled with the end-of-turn code check, vs 8 / 10 without it', note: 'Haiku · 5 multi-file tasks · 20 runs'},
  {big: '+5%', small: 'input tokens for that check, down from +74% for after-every-edit notes', note: 'same experiment'},
  {big: '45', small: 'languages with built-in code intelligence, most installed by Rein on request', note: 'clangd · gopls · rust-analyzer · pyright · …'},
  {big: '0', small: 'OAuth tokens touched. Every request goes through the official claude and codex binaries', note: 'by design'},
];

const trust = [
  {title: 'Official CLIs only', body: 'Rein never reads or reuses your login tokens. It drives claude and codex the way you would, signed in the normal way.'},
  {title: 'Secrets stay secret', body: 'Vault values go into commands, never into the conversation, transcripts or provider logs. Common encodings are masked too.'},
  {title: 'Untrusted work always asks', body: "Work started by an issue asks before every action, whatever mode you're in, and stays on its own branch."},
  {title: 'Remote, locked down', body: 'This computer only by default. One-time pairing codes, a random token, CSRF-safe requests, no hosted service.'},
];

const steps = [
  {cmd: 'npm install -g rein-harness', txt: 'Node 22+, on macOS, Linux and Windows'},
  {cmd: 'rein', txt: 'in any project; it finds your claude and codex logins'},
  {cmd: '/login', txt: 'add more accounts to the pool, any time'},
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07070a" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="grid-bg" aria-hidden="true"></div>

    <header class="nav">
      <a class="brand" href={base}>
        <span class="bars sm" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        <span>rein</span>
      </a>
      <nav>
        <a href="#features">Features</a>
        <a href="#compare">Why Rein</a>
        <a href="#trust">Security</a>
        <a href={docs('start/introduction')}>Docs</a>
        <a class="gh" href={repo} aria-label="GitHub">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>GitHub</span>
        </a>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="eyebrow">
          <span class="dot"></span> <span class="hide-xs">Open source · </span>drives the official <b>claude</b> &amp; <b>codex</b> CLIs
        </div>
        <div class="bars xl" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <h1>
          Every AI subscription.<br />
          <span class="rainbow-text">One terminal.</span>
        </h1>
        <p class="lede">
          Rein drives the official <code>claude</code> and <code>codex</code> CLIs across <em>all</em> your accounts, and gives every model
          the same superpowers: verified goals, undo for anything, code intelligence in 45 languages, a secrets vault, voice, and your
          session on your phone.
        </p>
        <div class="cta">
          <button class="install" data-copy="npm install -g rein-harness" aria-label="Copy install command">
            <span class="prompt">$</span> npm install -g rein-harness
            <span class="copy" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="2" d="M9 9h10v10H9zM5 15V5h10"/></svg>
            </span>
            <span class="copied">copied!</span>
          </button>
          <a class="btn primary" href={docs('start/introduction')}>Read the docs <span aria-hidden="true">→</span></a>
          <a class="btn ghost" href={repo}>★ Star on GitHub</a>
        </div>
        <p class="sub-cta">Or try it now: <code>npx rein-harness</code> · Node 22+ · macOS, Linux &amp; Windows</p>

        <!-- LIVE TERMINAL -->
        <div class="term-wrap">
          <div class="glow" aria-hidden="true"></div>
          <div class="term" id="demo" aria-label="Animated demo of the Rein terminal UI">
            <div class="chrome">
              <i></i><i></i><i></i>
              <span class="ttl">~/code/api — rein</span>
            </div>
            <div class="topbar">
              <span class="t-rainbow">▁▃▅▇ Rein</span>
              <span class="sep">│</span><span id="tb-model" class="t-cyan">Opus (auto)</span>
              <span class="sep">│</span><span id="tb-acct">Claude Account 1</span>
              <span class="sep">│</span><span id="tb-usage" class="t-dim">5h 84% · weekly 31%</span>
              <span class="sep">│</span><span class="t-green" id="tb-ctx">ctx 12%</span>
              <span class="sep hide-sm">│</span><span class="t-cyan hide-sm" id="tb-goal">◎ goal · active · 0/3</span>
              <span class="grow"></span><span class="t-dim">[≡]</span>
            </div>
            <div class="body">
              <div class="history" id="history"></div>
              <aside class="sidebar">
                <div class="sec">
                  <div class="h">GOAL · <span id="sb-goal-n">0/3</span></div>
                  <div class="t-dim small">Fix the auth tests</div>
                  <div class="meter"><span id="sb-goal-bar" style="width:0%"></span></div>
                  <div class="ms" id="ms1"><b>▸</b> Reproduce failure</div>
                  <div class="ms" id="ms2"><b>○</b> Fix session expiry</div>
                  <div class="ms" id="ms3"><b>○</b> Full suite green</div>
                </div>
                <div class="sec">
                  <div class="h">ACCOUNTS</div>
                  <div class="acct"><span>Claude Account 1</span><span class="pct" id="a1p">84%</span></div>
                  <div class="meter"><span id="a1" class="warn" style="width:84%"></span></div>
                  <div class="acct"><span>Claude Account 2</span><span class="pct" id="a2p">9%</span></div>
                  <div class="meter"><span id="a2" style="width:9%"></span></div>
                  <div class="acct"><span>Codex Account 1</span><span class="pct">22%</span></div>
                  <div class="meter"><span style="width:22%"></span></div>
                </div>
                <div class="sec">
                  <div class="h">AGENTS</div>
                  <div class="small"><span class="t-green">●</span> main</div>
                  <div class="small" id="sb-agent" style="opacity:.35"><span class="t-magenta">●</span> test-runner · Haiku</div>
                </div>
              </aside>
              <div class="btw-win" id="btw">
                <div class="btw-h"><span>btw · why did the tests fail?</span><span class="t-dim">[×]</span></div>
                <div class="btw-b" id="btw-body"></div>
                <div class="btw-f t-dim">Opus · forked agent · not added to the conversation</div>
              </div>
            </div>
            <div class="activity" id="activity"><span class="t-dim">esc interrupt · ctrl+c stop (twice to exit) · /btw to ask</span></div>
            <div class="input"><span class="t-cyan">›</span> <span id="typed"></span><span class="caret"></span></div>
          </div>
        </div>
      </section>

      <!-- WORKS WITH -->
      <section class="works" aria-label="Works with">
        <span class="works-h">Works with</span>
        <div class="works-row">{compat.map((c) => <span>{c}</span>)}</div>
      </section>

      <!-- PILLARS -->
      <section class="pillars">
        <div class="section-head">
          <div class="kicker">Why it's different</div>
          <h2>Not another agent.<br /><span class="rainbow-text">The harness around them all.</span></h2>
          <p>Rein doesn't replace Claude Code or Codex. It runs them, and adds what neither does on its own.</p>
        </div>
        <div class="pillar-grid">
          {
            pillars.map((p) => (
              <a class="pillar" href={docs(p.href)}>
                <span class="pillar-n">{p.n}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
                <ul>{p.points.map((x) => <li>{x}</li>)}</ul>
                <span class="pillar-more">Learn more →</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- BENTO -->
      <section class="features" id="features">
        <div class="section-head">
          <div class="kicker">What you get</div>
          <h2>Built like a power tool.</h2>
          <p>Every feature below works the same on every model, Claude or Codex.</p>
        </div>
        <div class="bento v2">
          {
            features.map((f) => (
              <a class={`tile ${f.span ?? ''}`} href={docs(f.href)}>
                <div class={`viz viz-${f.viz}`} aria-hidden="true">
                  {f.viz === 'bars' && (
                    <div class="v-bars">
                      <div><span>Claude Account 1</span><b style="--w:96%" class="hot" /></div>
                      <div><span>Claude Account 2</span><b style="--w:31%" /></div>
                      <div><span>Codex Account 1</span><b style="--w:18%" /></div>
                      <p class="t-yellow">Load balancing: Claude Account 1 is near its limit — switching to Claude Account 2 before it's rejected</p>
                    </div>
                  )}
                  {f.viz === 'route' && (
                    <pre><span class="t-dim">› rename this variable</span>{'\n'}<span class="t-dim">→ Haiku · Claude Account 2</span>{'\n'}<span class="t-dim">› design the cache layer</span>{'\n'}<span class="t-dim">→ </span><span class="t-cyan">Opus · effort high</span></pre>
                  )}
                  {f.viz === 'lsp' && (
                    <pre><span class="t-green">⏺</span> <b>Edit</b><span class="t-dim">(math.ts)</span>{'\n'}<span class="t-green">⏺</span> <b>Edit</b><span class="t-dim">(cart.ts)</span>{'\n'}<span class="t-yellow">Code check:</span> <span class="t-dim">your changes left 1 problem</span>{'\n'}  <span class="t-pink">main.ts:2:14</span> <span class="t-dim">error ts 2322</span>{'\n'}  <span class="t-dim">Type 'string' is not assignable</span>{'\n'}  <span class="t-dim">to type 'number'.</span>{'\n'}<span class="t-green">⏺</span> <b>Edit</b><span class="t-dim">(main.ts)</span>{'\n'}<span class="t-green">✓ compiles</span>{'\n\n'}<span class="t-dim">clangd · gopls · rust-analyzer</span>{'\n'}<span class="t-dim">pyright · tsc · zls · jdtls · …</span></pre>
                  )}
                  {f.viz === 'goal' && (
                    <pre><span class="t-green">⏺</span> <b>Shell</b><span class="t-dim">(npm test)</span>{'\n'}  <span class="t-green">✓ 48 passed</span>{'\n'}<span class="t-green">◎ Goal achieved and verified</span></pre>
                  )}
                  {f.viz === 'vault' && (
                    <pre><span class="t-dim">$</span> curl -H "Bearer $GITHUB_TOKEN" …{'\n'}<span class="t-dim">$</span> echo $GITHUB_TOKEN{'\n'}<span class="t-cyan">[secret:GITHUB_TOKEN]</span></pre>
                  )}
                  {f.viz === 'plan' && (
                    <pre><span class="t-yellow">⏸ plan mode</span>{'\n'}<span class="t-dim">## Milestones</span>{'\n'}- [x] Map the auth flow{'\n'}- [ ] Migrate sessions</pre>
                  )}
                  {f.viz === 'rewind' && (
                    <pre><span class="t-cyan">Restore code and conversation</span>{'\n'}<span class="t-dim">Restore conversation only</span>{'\n'}<span class="t-dim">esc esc · 4 files</span></pre>
                  )}
                  {f.viz === 'remote' && (
                    <div class="v-remote">
                      <div class="phone">
                        <div class="p-top">Rein · api · Opus</div>
                        <div class="p-msg you">add rate limiting to /login</div>
                        <div class="p-msg">Added a sliding-window limiter…</div>
                        <div class="p-ask">
                          <b>Rein wants to Shell</b><span>npm test</span>
                          <div class="p-btns"><i class="ok">Allow</i><i>Session</i><i class="no">Deny</i></div>
                        </div>
                      </div>
                      <pre class="v-remote-term"><span class="t-dim">› /remote</span>{'\n'}<span class="t-dim">⎿</span> Remote page: http://localhost:7377{'\n'}  pairing code <span class="t-cyan">482913</span> (5 minutes){'\n'}<span class="t-dim">⎿ ⇢ from the remote page</span></pre>
                    </div>
                  )}
                  {f.viz === 'tracker' && (
                    <pre><span class="t-dim">⇢ github #2 "Add multiply"</span>{'\n'}<span class="t-dim">  started · labelled </span><span class="t-violet">rein</span>{'\n'}<span class="t-green">⇢ done</span> <span class="t-dim">· branch</span> <span class="t-cyan">rein/issue-2</span>{'\n'}<span class="t-dim">  the report is on the issue</span></pre>
                  )}
                  {f.viz === 'voice' && (
                    <div class="v-voice">
                      <div class="wave">{Array.from({length: 24}, (_, i) => <i style={`--d:${(i * 37) % 11}`} />)}</div>
                      <span class="t-red">● Recording… let go of Ctrl+Space</span>
                    </div>
                  )}
                  {f.viz === 'sampling' && (
                    <pre><span class="t-dim">MCP server "notes" wants a model</span>{'\n'}<span class="t-dim">→</span> <span class="t-cyan">Haiku 4.5</span> <span class="t-dim">· your subscription</span>{'\n'}<span class="t-dim">no API key needed</span></pre>
                  )}
                  {f.viz === 'btw' && (
                    <div class="v-btw">
                      <div class="v-main"><span class="t-dim">main</span> ▇▅▃▁ Responding…</div>
                      <div class="v-fork"><span class="t-cyan">btw ·</span> what's left?<br /><span class="t-dim">forked agent · not added</span></div>
                    </div>
                  )}
                  {f.viz === 'agents' && (
                    <div class="v-agents">
                      <span class="node main">main · Opus</span>
                      <span class="edge" />
                      <span class="node">reviewer · fork</span>
                      <span class="node">tests · Haiku</span>
                      <span class="node">docs · Codex</span>
                    </div>
                  )}
                </div>
                <div class="tile-txt">
                  <span class="tag">{f.tag}</span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </div>
              </a>
            ))
          }
        </div>

        <div class="mini-grid">
          <a href={docs('features/tools')}><b>One tool set, every model</b><span>read · edit · search · shell · web · images · memory</span></a>
          <a href={docs('start/from-claude-code')}><b>Claude Code compatible</b><span>settings, hooks, CLAUDE.md, plugins, .mcp.json</span></a>
          <a href={docs('features/ide')}><b>Your editor</b><span>VS Code, Cursor, JetBrains, Neovim: selection, diffs, diagnostics</span></a>
          <a href={docs('features/permissions')}><b>Approvals that learn</b><span>ask · auto via a decision model · bypass · saved rules · sandbox</span></a>
          <a href={docs('features/web-and-images')}><b>Images inline</b><span>generated and pasted images, right in kitty, Ghostty, iTerm2</span></a>
          <a href={docs('features/headless')}><b>Headless &amp; CI</b><span>rein -p "…" --output-format json</span></a>
        </div>
      </section>

      <!-- PROOF -->
      <section class="proof">
        <div class="section-head">
          <div class="kicker">Measured, not claimed</div>
          <h2>We test the features on real models.</h2>
          <p>When a feature didn't pay for itself, we changed it. The numbers come from the runs that decided it.</p>
        </div>
        <div class="proof-grid">
          {
            proof.map((p) => (
              <div class="proof-card">
                <b>{p.big}</b>
                <span>{p.small}</span>
                <em>{p.note}</em>
              </div>
            ))
          }
        </div>
      </section>

      <!-- COMPARE -->
      <section class="compare" id="compare">
        <div class="section-head">
          <div class="kicker">With or without Rein</div>
          <h2>Everything the official CLIs do.<br />Plus everything around them.</h2>
          <p>Rein runs <code>claude</code> and <code>codex</code> as they are, so you keep what they're good at, and gain this.</p>
        </div>
        <div class="cmp" role="table">
          <div class="cmp-row cmp-head" role="row">
            <span role="columnheader"></span>
            <span role="columnheader">A CLI by itself</span>
            <span role="columnheader" class="us">
              <span class="bars sm" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span> With Rein
            </span>
          </div>
          {
            compare.map(([what, alone, rein]) => (
              <div class="cmp-row" role="row">
                <span role="rowheader">{what}</span>
                <span role="cell" class="alone">{alone}</span>
                <span role="cell" class="us">{rein}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- HOW -->
      <section class="how">
        <div class="section-head">
          <div class="kicker">How it works</div>
          <h2>No tokens extracted. Ever.</h2>
          <p>All model traffic goes through the official binaries, signed in the normal way. Rein orchestrates.</p>
        </div>
        <div class="flow">
          <div class="node-card">
            <div class="n-h">You</div>
            <div class="n-b">fullscreen TUI · phone · issues · <code>rein -p</code></div>
          </div>
          <div class="pipe"><span></span></div>
          <div class="node-card hl">
            <div class="n-h"><span class="t-rainbow">Rein</span></div>
            <div class="n-b">transcript · router · account pool · tool host · approvals · vault · language servers</div>
          </div>
          <div class="pipe split"><span></span></div>
          <div class="node-stack">
            <div class="node-card"><div class="n-h">claude</div><div class="n-b">stream-json · MCP proxy</div></div>
            <div class="node-card"><div class="n-h">codex</div><div class="n-b">app-server · dynamic tools</div></div>
          </div>
        </div>
        <div class="center"><a class="btn ghost" href={docs('internals/architecture')}>Read the architecture →</a></div>
      </section>

      <!-- TRUST -->
      <section class="trust" id="trust">
        <div class="section-head">
          <div class="kicker">Security</div>
          <h2>Powerful, and careful about it.</h2>
        </div>
        <div class="trust-grid">
          {
            trust.map((t) => (
              <div class="trust-card">
                <span class="shield" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                </span>
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </div>
            ))
          }
        </div>
        <div class="center"><a class="btn ghost" href={docs('project/security')}>The security model →</a></div>
      </section>

      <!-- START -->
      <section class="start">
        <div class="section-head">
          <div class="kicker">Get started</div>
          <h2>Running in a minute.</h2>
        </div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="step-n">{i + 1}</span>
                <code>{s.cmd}</code>
                <span>{s.txt}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- CONTRIBUTE -->
      <section class="contribute">
        <div class="contrib-card">
          <div class="kicker">Build it with us</div>
          <h2>Rein is young, fast-moving, and <span class="rainbow-text">wide open</span>.</h2>
          <p>
            TypeScript, Ink and React. Tests run against fake <code>claude</code> and <code>codex</code> binaries, so you don't need a
            subscription to hack on it. Every merged PR ships to npm automatically.
          </p>
          <div class="cta left">
            <a class="btn primary" href={docs('project/contributing')}>Start contributing →</a>
            <a class="btn ghost" href={`${repo}/issues`}>Browse issues</a>
          </div>
        </div>
      </section>

      <!-- FINAL -->
      <section class="final">
        <div class="bars xl" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <h2>One CLI, Every Workflow.</h2>
        <button class="install big" data-copy="npm install -g rein-harness">
          <span class="prompt">$</span> npm install -g rein-harness
          <span class="copied">copied!</span>
        </button>
        <p class="sub-cta">then <code>cd</code> into a project and run <code>rein</code></p>
      </section>
    </main>

    <footer class="foot">
      <div>
        <span class="bars sm" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        Rein · open source
      </div>
      <div class="links">
        <a href={docs('start/introduction')}>Docs</a>
        <a href={docs('project/security')}>Security</a>
        <a href={repo}>GitHub</a>
        <a href="https://www.npmjs.com/package/rein-harness">npm</a>
      </div>
      <p class="fine">Rein is an independent project. It is not affiliated with Anthropic or OpenAI. It drives their official CLIs with your own accounts.</p>
    </footer>

    <script>import "../scripts/landing.ts";</script>
  </body>
