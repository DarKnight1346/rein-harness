{
  "name": "rein-harness",
  "version": "0.1.0",
  "description": "Terminal chat harness that drives Claude Code and Codex across multiple subscription accounts",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cli",
    "tui",
    "ai",
    "agent",
    "harness",
    "terminal"
  ],
  "homepage": "https://github.com/DarKnight1346/rein-harness#readme",
  "bugs": {
    "url": "https://github.com/DarKnight1346/rein-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarKnight1346/rein-harness.git"
  },
  "type": "module",
  "bin": {
    "rein": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^5.6.2",
    "cli-truncate": "^6.1.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "ink": "^7.1.1",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
